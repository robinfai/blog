---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
  currentId: string;
};
const { posts, currentId } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const currentIndex = posts.findIndex(post => post.id === currentId);
---

<nav
  aria-label="五彩斑斓的黑系列目录"
  data-pagefind-ignore
  class="series-nav border-border mt-6 rounded-lg border p-4"
>
  <details>
    <summary class="text-accent cursor-pointer font-medium">
      五彩斑斓的黑 · 第 {currentIndex + 1} / {posts.length} 篇
      <span class="text-muted-foreground ms-2 text-sm">系列目录</span>
    </summary>
    <ol class="mt-3 list-decimal space-y-2 ps-6">
      {
        posts.map(post => (
          <li>
            <a
              href={getPostUrl(post.id, post.filePath, locale)}
              aria-current={post.id === currentId ? "page" : undefined}
              class:list={[
                "hover:text-accent block py-1",
                { "text-accent font-semibold": post.id === currentId },
              ]}
            >
              {post.data.title}
            </a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>
